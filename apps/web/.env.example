# Segredos de servidor. Nunca use prefixo NEXT_PUBLIC_.
# Copie do Neon: string de conexão PostgreSQL com SSL, de preferência pooled.
DATABASE_URL=postgresql://USUARIO:SENHA@HOST/neondb?sslmode=require

# Segredo aleatório com pelo menos 32 caracteres, exigido apenas no primeiro cadastro.
ZORD_SETUP_TOKEN=SUBSTITUA_POR_UM_SEGREDO_ALEATORIO_COM_64_CARACTERES
